@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

@prefix lv2:     <http://lv2plug.in/ns/lv2core#> .
@prefix lv2ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix pset:    <http://lv2plug.in/ns/ext/presets#> .
@prefix atom:    <http://lv2plug.in/ns/ext/atom#> .
@prefix lv2midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix pg:      <http://lv2plug.in/ns/ext/port-groups#> .
@prefix urid:    <http://lv2plug.in/ns/ext/urid#> .
@prefix worker:  <http://lv2plug.in/ns/ext/worker#> .
@prefix state:   <http://lv2plug.in/ns/ext/state#> .
@prefix patch:   <http://lv2plug.in/ns/ext/patch#> .

<http://github.com/ssj71/reMID.lv2/blob/master/instruments/instruments.conf>
    a lv2:Parameter ;
    rdfs:label "SWI Bank File" ;
    rdfs:range atom:Path ;
    rdfs:comment "Path to a .swibank file which maps MIDI program numbers to SID-Wizard .swi instruments." ;
    .

<http://github.com/ssj71/reMID.lv2#channel_state>
    a lv2:Parameter ;
    rdfs:label "Channel State" ;
    rdfs:range atom:Blank ;
    rdfs:comment "Notify-only. The plugin emits patch:Set messages on the NOTIFY port with per-channel bank/program state." ;
    .

<http://github.com/ssj71/reMID.lv2#bank_name>
    a lv2:Parameter ;
    rdfs:label "Bank Name" ;
    rdfs:range atom:String ;
    rdfs:comment "Notify-only. Human-readable bank name for a channel_state update." ;
    .

<http://github.com/ssj71/reMID.lv2#patch_name>
    a lv2:Parameter ;
    rdfs:label "Patch Name" ;
    rdfs:range atom:String ;
    rdfs:comment "Notify-only. Human-readable patch description for a channel_state update." ;
    .

<http://github.com/ssj71/reMID.lv2/polyphony>
    a lv2:Parameter ;
    rdfs:label "polyphony" ;
    rdfs:range atom:Int ;
    .

<http://github.com/ssj71/reMID.lv2/chip_type>
    a lv2:Parameter ;
    rdfs:label "chip type" ;
    rdfs:range atom:Int ;
    .

<http://github.com/ssj71/reMID.lv2/use_sid_volume>
    a lv2:Parameter ;
    rdfs:label "use volume of chip" ;
    rdfs:range atom:Bool ;
    .

<http://github.com/ssj71/reMID.lv2#channel_programs>
    a pg:Group ;
    lv2:name "Channel Programs" ;
    lv2:symbol "channel_programs" ;
    .

<http://github.com/ssj71/reMID.lv2>
    a doap:Project, lv2:Plugin, lv2:InstrumentPlugin ;
    doap:name "reMID" ;
    doap:license <http://opensource.org/licenses/GPL-2.0> ;
    doap:description "MIDI-controlled emulation of a SID chip (direct SID-Wizard .swi instrument runtime)" ;
    doap:maintainer [
        foaf:name "Spencer Jackson" ;
        foaf:homepage <http://ssj71.github.io/infamousPlugins> ;
        foaf:mbox <mailto:ssjackson71@gmail.com> ;
    ] ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;
    rdfs:comment "This MIDI-controlled SID emulator loads .swibank files which select SID-Wizard .swi instruments to run at runtime (no reMID .conf instrument language)." ;
    lv2:requiredFeature urid:map, worker:schedule ;
    lv2:optionalFeature lv2:hardRTCapable, state:loadDefaultState ;
    lv2:extensionData worker:interface, state:interface ;
    patch:writable <http://github.com/ssj71/reMID.lv2/blob/master/instruments/instruments.conf> ;
    patch:readable <http://github.com/ssj71/reMID.lv2#channel_state> ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "OUTPUT_R" ;
        lv2:name "Right Out" ;
    ] ;
    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "OUTPUT_L" ;
        lv2:name "Left Out" ;
    ] ;
    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports lv2midi:MidiEvent ;
        atom:supports patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 2 ;
        lv2:symbol "MIDI_IN" ;
        lv2:name "MIDI In" ;
    ] ;
    lv2:port [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 3 ;
        lv2:symbol "NOTIFY" ;
        lv2:name "Notify" ;
    ] ;

    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "ch1_program" ;
        lv2:name "Ch 1 Program" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 128 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Optional override. 0 uses incoming MIDI Program Change; 1..128 selects a program." ;
        pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ;
    ] ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "ch2_program" ;
        lv2:name "Ch 2 Program" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 128 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Optional override. 0 uses incoming MIDI Program Change; 1..128 selects a program." ;
        pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ;
    ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6  ; lv2:symbol "ch3_program"  ; lv2:name "Ch 3 Program"  ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7  ; lv2:symbol "ch4_program"  ; lv2:name "Ch 4 Program"  ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8  ; lv2:symbol "ch5_program"  ; lv2:name "Ch 5 Program"  ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9  ; lv2:symbol "ch6_program"  ; lv2:name "Ch 6 Program"  ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "ch7_program"  ; lv2:name "Ch 7 Program"  ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "ch8_program"  ; lv2:name "Ch 8 Program"  ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "ch9_program"  ; lv2:name "Ch 9 Program"  ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "ch10_program" ; lv2:name "Ch 10 Program" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "ch11_program" ; lv2:name "Ch 11 Program" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 15 ; lv2:symbol "ch12_program" ; lv2:name "Ch 12 Program" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 16 ; lv2:symbol "ch13_program" ; lv2:name "Ch 13 Program" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 17 ; lv2:symbol "ch14_program" ; lv2:name "Ch 14 Program" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 18 ; lv2:symbol "ch15_program" ; lv2:name "Ch 15 Program" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] ;
    lv2:port [ a lv2:InputPort, lv2:ControlPort ; lv2:index 19 ; lv2:symbol "ch16_program" ; lv2:name "Ch 16 Program" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 128 ; lv2:portProperty lv2:integer ; pg:group <http://github.com/ssj71/reMID.lv2#channel_programs> ; ] .

