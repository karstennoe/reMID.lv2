<http://github.com/ssj71/reMID.lv2/blob/master/instruments/banks/bank-all-0.swibank>
    a pset:Preset ;
    lv2:appliesTo <http://github.com/ssj71/reMID.lv2> ;
    rdfs:label "BANK: All (0)" ;
    state:state [
        <http://github.com/ssj71/reMID.lv2/blob/master/instruments/instruments.conf> <instruments/banks/bank-all-0.swibank>
    ] .

